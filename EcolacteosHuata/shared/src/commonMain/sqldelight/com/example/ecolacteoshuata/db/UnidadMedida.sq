CREATE TABLE unidad_medida (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    simbolo TEXT NOT NULL
);

selectAll:
SELECT * FROM unidad_medida ORDER BY (SELECT creado_en FROM orden_alta WHERE tabla = 'unidad_medida' AND registro_id = unidad_medida.id) DESC, CASE WHEN unidad_medida.id NOT GLOB '*[^0-9]*' THEN CAST(unidad_medida.id AS INTEGER) END DESC, (SELECT secuencia FROM orden_alta WHERE tabla = 'unidad_medida' AND registro_id = unidad_medida.id) DESC, unidad_medida.id DESC;

selectById:
SELECT * FROM unidad_medida WHERE id = ?;

insert:
INSERT INTO unidad_medida(id, nombre, simbolo) VALUES (?, ?, ?);

update:
UPDATE unidad_medida SET nombre = ?, simbolo = ? WHERE id = ?;

deleteById:
DELETE FROM unidad_medida WHERE id = ?;

upsertFromSync:
INSERT OR REPLACE INTO unidad_medida(id, nombre, simbolo) VALUES (?, ?, ?);
