-- Turnos de producción de planta (tabla `turnos_produccion` de Laravel). Se agregó al esquema
-- sin migración, así que en los teléfonos ya instalados faltaba y la sincronización fallaba
-- con "no such table: turno_produccion".
CREATE TABLE IF NOT EXISTS turno_produccion (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    hora_inicio TEXT NOT NULL,
    hora_fin TEXT NOT NULL
);
