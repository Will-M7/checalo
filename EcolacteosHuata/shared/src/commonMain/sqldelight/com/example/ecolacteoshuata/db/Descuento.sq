-- Descuentos que el vendedor puede activar en el punto de venta (tabla `descuentos` de Laravel).
CREATE TABLE descuento (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    porcentaje REAL NOT NULL,
    activo INTEGER NOT NULL DEFAULT 1
);

selectAll:
SELECT * FROM descuento ORDER BY (SELECT creado_en FROM orden_alta WHERE tabla = 'descuento' AND registro_id = descuento.id) DESC, CASE WHEN descuento.id NOT GLOB '*[^0-9]*' THEN CAST(descuento.id AS INTEGER) END DESC, (SELECT secuencia FROM orden_alta WHERE tabla = 'descuento' AND registro_id = descuento.id) DESC, descuento.id DESC;

selectDisponibles:
SELECT * FROM descuento WHERE activo = 1 ORDER BY (SELECT creado_en FROM orden_alta WHERE tabla = 'descuento' AND registro_id = descuento.id) DESC, CASE WHEN descuento.id NOT GLOB '*[^0-9]*' THEN CAST(descuento.id AS INTEGER) END DESC, (SELECT secuencia FROM orden_alta WHERE tabla = 'descuento' AND registro_id = descuento.id) DESC, descuento.id DESC;

insert:
INSERT INTO descuento(id, nombre, porcentaje, activo) VALUES (?, ?, ?, ?);

update:
UPDATE descuento SET nombre = ?, porcentaje = ?, activo = ? WHERE id = ?;

setActivo:
UPDATE descuento SET activo = ? WHERE id = ?;

deleteById:
DELETE FROM descuento WHERE id = ?;

upsertFromSync:
INSERT OR REPLACE INTO descuento(id, nombre, porcentaje, activo) VALUES (?, ?, ?, ?);
