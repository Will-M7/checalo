CREATE TABLE insumo (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    unidad_medida_id TEXT NOT NULL,
    stock_minimo REAL NOT NULL DEFAULT 0,
    -- Como en Laravel: costo por unidad y stock con el que se registra el insumo.
    costo_unitario REAL NOT NULL DEFAULT 0,
    stock_actual REAL NOT NULL DEFAULT 0,
    -- Stock con el que se registró (es lo que se sube al crear el insumo en Laravel).
    stock_inicial REAL NOT NULL DEFAULT 0,
    -- 1 = el stock se corrigió a mano en el teléfono y Laravel debe tomarlo al subirlo.
    stock_editado INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (unidad_medida_id) REFERENCES unidad_medida(id)
);

selectAll:
SELECT * FROM insumo ORDER BY nombre;

selectById:
SELECT * FROM insumo WHERE id = ?;

insert:
INSERT INTO insumo(id, nombre, unidad_medida_id, stock_minimo, costo_unitario, stock_actual, stock_inicial) VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE insumo SET nombre = ?, unidad_medida_id = ?, stock_minimo = ?, costo_unitario = ?, stock_actual = ?, stock_editado = ? WHERE id = ?;

-- Compras y producciones mueven el stock (y las compras el costo promedio), como en Laravel.
actualizarStockYCosto:
UPDATE insumo SET stock_actual = ?, costo_unitario = ? WHERE id = ?;

deleteById:
DELETE FROM insumo WHERE id = ?;

-- El stock real lo manda Laravel; stock_minimo es solo del dispositivo.
actualizarDatosSync:
UPDATE insumo SET nombre = ?, unidad_medida_id = ?, costo_unitario = ?, stock_actual = ?, stock_editado = 0 WHERE id = ?;
