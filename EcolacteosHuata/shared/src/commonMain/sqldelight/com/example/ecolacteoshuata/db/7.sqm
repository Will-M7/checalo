-- Descuentos del punto de venta, como la tabla `descuentos` de Laravel.
CREATE TABLE IF NOT EXISTS descuento (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    porcentaje REAL NOT NULL,
    activo INTEGER NOT NULL DEFAULT 1
);
-- Descarga completa en el próximo sync para traer los descuentos que ya existen en Laravel.
UPDATE conexion_servidor SET ultima_sincronizacion = NULL;
