CREATE TABLE entrega_planta (
    id TEXT NOT NULL PRIMARY KEY,
    acopiador_id TEXT NOT NULL,
    turno_id TEXT NOT NULL,
    fecha TEXT NOT NULL,
    litros_total REAL NOT NULL,
    total_pagado REAL NOT NULL,
    total_deuda REAL NOT NULL,
    proveedores_no_recogidos INTEGER NOT NULL,
    guia TEXT NOT NULL,
    FOREIGN KEY (acopiador_id) REFERENCES acopiador(id),
    FOREIGN KEY (turno_id) REFERENCES turno(id)
);

selectAll:
SELECT * FROM entrega_planta ORDER BY (SELECT creado_en FROM orden_alta WHERE tabla = 'entrega_planta' AND registro_id = entrega_planta.id) DESC, CASE WHEN entrega_planta.id NOT GLOB '*[^0-9]*' THEN CAST(entrega_planta.id AS INTEGER) END DESC, (SELECT secuencia FROM orden_alta WHERE tabla = 'entrega_planta' AND registro_id = entrega_planta.id) DESC, entrega_planta.id DESC;

selectByAcopiador:
SELECT * FROM entrega_planta WHERE acopiador_id = ? ORDER BY (SELECT creado_en FROM orden_alta WHERE tabla = 'entrega_planta' AND registro_id = entrega_planta.id) DESC, CASE WHEN entrega_planta.id NOT GLOB '*[^0-9]*' THEN CAST(entrega_planta.id AS INTEGER) END DESC, (SELECT secuencia FROM orden_alta WHERE tabla = 'entrega_planta' AND registro_id = entrega_planta.id) DESC, entrega_planta.id DESC;

selectEntreFechas:
SELECT * FROM entrega_planta WHERE fecha >= ? AND fecha <= ? ORDER BY (SELECT creado_en FROM orden_alta WHERE tabla = 'entrega_planta' AND registro_id = entrega_planta.id) DESC, CASE WHEN entrega_planta.id NOT GLOB '*[^0-9]*' THEN CAST(entrega_planta.id AS INTEGER) END DESC, (SELECT secuencia FROM orden_alta WHERE tabla = 'entrega_planta' AND registro_id = entrega_planta.id) DESC, entrega_planta.id DESC;

insert:
INSERT INTO entrega_planta(id, acopiador_id, turno_id, fecha, litros_total, total_pagado, total_deuda, proveedores_no_recogidos, guia)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertFromSync:
INSERT OR REPLACE INTO entrega_planta(id, acopiador_id, turno_id, fecha, litros_total, total_pagado, total_deuda, proveedores_no_recogidos, guia)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);
