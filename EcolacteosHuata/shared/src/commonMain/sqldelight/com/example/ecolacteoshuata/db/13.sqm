-- Subida app -> Laravel: cola de cambios hechos en el teléfono (la llenan triggers creados por
-- RegistroCambios.kt) y bandera para no anotar lo que llega del servidor.
CREATE TABLE IF NOT EXISTS cambio_pendiente (
    orden INTEGER PRIMARY KEY AUTOINCREMENT,
    tabla TEXT NOT NULL,
    registro_id TEXT NOT NULL,
    operacion TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS sync_control (
    id INTEGER NOT NULL PRIMARY KEY,
    aplicando INTEGER NOT NULL DEFAULT 0
);

INSERT OR IGNORE INTO sync_control(id, aplicando) VALUES (1, 0);

-- Lo que ya se había creado en el teléfono (id UUID, no numérico como los de Laravel) se sube
-- en la próxima sincronización. Primero los registros de los que dependen los demás.
INSERT INTO cambio_pendiente(tabla, registro_id, operacion) SELECT 'usuario', id, 'guardar' FROM usuario WHERE id GLOB '*[^0-9]*';
INSERT INTO cambio_pendiente(tabla, registro_id, operacion) SELECT 'acopiador', id, 'guardar' FROM acopiador WHERE id GLOB '*[^0-9]*';
INSERT INTO cambio_pendiente(tabla, registro_id, operacion) SELECT 'proveedor', id, 'guardar' FROM proveedor WHERE id GLOB '*[^0-9]*';
