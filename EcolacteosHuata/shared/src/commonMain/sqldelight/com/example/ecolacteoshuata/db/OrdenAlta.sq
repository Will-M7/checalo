CREATE TABLE orden_alta (
    secuencia INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    tabla TEXT NOT NULL,
    registro_id TEXT NOT NULL,
    creado_en TEXT,
    UNIQUE(tabla, registro_id)
);

asegurarFechaServidor:
INSERT OR IGNORE INTO orden_alta(tabla, registro_id, creado_en) VALUES (?, ?, ?);

guardarFechaServidor:
UPDATE orden_alta SET creado_en = ? WHERE tabla = ? AND registro_id = ?;
