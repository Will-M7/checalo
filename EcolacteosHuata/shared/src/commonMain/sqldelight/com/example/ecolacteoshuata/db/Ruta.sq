CREATE TABLE ruta (
    id TEXT NOT NULL PRIMARY KEY,
    acopiador_id TEXT NOT NULL,
    nombre TEXT NOT NULL,
    activa INTEGER NOT NULL DEFAULT 1,
    trazo TEXT,
    FOREIGN KEY (acopiador_id) REFERENCES acopiador(id)
);

CREATE TABLE ruta_proveedor (
    ruta_id TEXT NOT NULL,
    proveedor_id TEXT NOT NULL,
    orden INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (ruta_id, proveedor_id),
    FOREIGN KEY (ruta_id) REFERENCES ruta(id),
    FOREIGN KEY (proveedor_id) REFERENCES proveedor(id)
);

selectAll:
SELECT * FROM ruta ORDER BY nombre;

selectByAcopiador:
SELECT * FROM ruta WHERE acopiador_id = ? ORDER BY nombre;

selectById:
SELECT * FROM ruta WHERE id = ?;

insert:
INSERT INTO ruta(id, acopiador_id, nombre, activa) VALUES (?, ?, ?, ?);

update:
UPDATE ruta SET nombre = ?, acopiador_id = ?, activa = ? WHERE id = ?;

actualizarTrazo:
UPDATE ruta SET trazo = ? WHERE id = ?;

deleteById:
DELETE FROM ruta WHERE id = ?;

selectProveedoresDeRuta:
SELECT proveedor_id FROM ruta_proveedor WHERE ruta_id = ? ORDER BY orden, rowid;

asignarProveedor:
INSERT OR IGNORE INTO ruta_proveedor(ruta_id, proveedor_id, orden) VALUES (?, ?, ?);

actualizarOrden:
UPDATE ruta_proveedor SET orden = ? WHERE ruta_id = ? AND proveedor_id = ?;

quitarProveedor:
DELETE FROM ruta_proveedor WHERE ruta_id = ? AND proveedor_id = ?;

limpiarProveedoresDeRuta:
DELETE FROM ruta_proveedor WHERE ruta_id = ?;

upsertFromSync:
INSERT OR REPLACE INTO ruta(id, acopiador_id, nombre, activa, trazo) VALUES (?, ?, ?, ?, ?);
